---

source: {{ source_video }}
output_dir: {{ output_dir }}  # Output directory
output_extension: mp4
compress: yes  # Compress the output video, yes for True, others for False, e.g. no
{% if source_is_dir %}
files:{% for file in files %}
  - filename: {{ file.filename }}
    clips:{% for clip in file.clips %}
      - start: {{ clip.start }}   # Start time of the clip
        end: {{ clip.end }}     # End time of the clip
        title: "{{ clip.title }}"{% endfor %}
  {% endfor %}
{% else %}
clips:
  - start: {{ clip_1_start }}   # Start time of the clip
    end: {{ clip_1_end }}     # End time of the clip
    title: "{{ clip_1_title }}"
{% endif %}
